# Copy to .env.local and fill only what you actually configure.
# Never commit real secrets. These are server-side only unless prefixed by NEXT_PUBLIC_.

# AL NAEEM API (preferred). Include /api/v1.
# Browser-visible alias is optional; Admin data access is server-side and uses API_BASE_URL.
API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# sqlite = local development fallback only. api = real AL NAEEM API (required for production).
# Never auto-fallback from API failures to SQLite.
DATA_ADAPTER=api

# Development only with DATA_ADAPTER=sqlite. Ignored when DATA_ADAPTER=api or NODE_ENV=production.
ADMIN_DEV_BYPASS=false

# Optional local SQLite path (sqlite adapter only). Defaults to data/local/al-naeem.sqlite.
AL_NAEEM_DATABASE_PATH=

# Image search. Without this, product image search reports a disconnected state.
SERPER_API_KEY=

# WhatsApp Business Cloud API. Without these, WhatsApp integration is disabled.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# AI agent provider. Without this, AI assistance is disabled.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_MODEL=

# Legacy sqlite-mode session token only (not used when DATA_ADAPTER=api).
# Production auth is owned by AL NAEEM API HttpOnly cookie al-naeem-admin-session.
AL_NAEEM_ADMIN_SESSION_TOKEN=
