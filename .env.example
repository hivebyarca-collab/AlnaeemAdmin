# Copy to .env.local for local development. Never commit real secrets.
# On Vercel, set these in Project → Settings → Environment Variables.

# --- Required for production (Vercel Admin @ admin.alnaeem.com) ---
# AL NAEEM API base including /api/v1. Not a secret.
API_BASE_URL=http://localhost:4000/api/v1
# Optional public alias of the same non-secret URL (browser-safe). Prefer API_BASE_URL server-side.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Production always uses the API adapter. For local SQLite fallback only:
# DATA_ADAPTER=sqlite
DATA_ADAPTER=api

# Development-only auth bypass. Ignored when DATA_ADAPTER=api, on Vercel, or NODE_ENV=production.
# Production must keep this false. Do not enable on Vercel.
ADMIN_DEV_BYPASS=false

# --- Local SQLite only (never used on Vercel) ---
AL_NAEEM_DATABASE_PATH=

# --- Optional integrations (server-only secrets) ---
SERPER_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_MODEL=

# Legacy local session token for DATA_ADAPTER=sqlite without bypass. Not used with API auth.
AL_NAEEM_ADMIN_SESSION_TOKEN=

# Do NOT set DATABASE_URL in this Admin app.
# PostgreSQL / Railway credentials belong exclusively on AL NAEEM API.
