# Copy to .env.local and fill only what you actually configure.
# Never commit real secrets. These are server-side only unless prefixed by NEXT_PUBLIC_.

# Future backend connection point. The current admin still uses the local
# SQLite prototype when this is unset.
API_BASE_URL=http://localhost:4000

# Optional local SQLite path. Defaults to data/local/al-naeem.sqlite.
AL_NAEEM_DATABASE_PATH=

# Image search. Without this, product image search reports a disconnected state.
SERPER_API_KEY=

# WhatsApp Business Cloud API. Without these, WhatsApp integration is disabled.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# AI agent provider. Without this, AI assistance is disabled.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_MODEL=

# Admin authorization. Privileged routes deny access unless this token is placed
# in the al-naeem-admin-session cookie by a real authentication layer.
AL_NAEEM_ADMIN_SESSION_TOKEN=
